# ============================================================
# KALENGO — contoh environment. SALIN ke .env lalu isi nilainya.
# JANGAN commit .env (lihat .gitignore). Rahasia lewat secret manager di prod.
# ============================================================

# ---- App ----
APP_ENV=development                # development | staging | production
APP_NAME=kalengo
APP_VERSION=dev                    # diisi saat build (-ldflags) di produksi
APP_COMMIT=unknown
HTTP_ADDR=:8080
LOG_LEVEL=debug                    # debug | info | warn | error
BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173   # whitelist CORS (dipisah koma bila banyak)
SHUTDOWN_TIMEOUT=15s               # waktu tunggu penutupan rapi
HTTP_REQUEST_TIMEOUT=25s           # batas satu permintaan (timeout chi)
HTTP_MAX_BODY_BYTES=1048576        # 1 MB — batas body (§13.1)
# Aktifkan HANYA bila API berada di belakang reverse proxy (nginx §15),
# agar X-Forwarded-For dipercaya. Salah setelan ini = rate limit bisa dipalsukan.
HTTP_TRUST_PROXY_HEADERS=false

# ---- Database ----
# Koneksi aplikasi: role LEAST PRIVILEGE (tanpa DDL) — §13.1
DATABASE_URL=postgres://kalengo_app:app_dev_password@localhost:5432/kalengo?sslmode=disable&application_name=kalengo-api
# Koneksi migrasi: role pemilik skema (hak DDL) — hanya dipakai Makefile/CI, bukan runtime
MIGRATE_DATABASE_URL=postgres://kalengo_migrator:migrator_dev_password@localhost:5432/kalengo?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# ---- Redis (cache, rate limit, pub/sub, antrean Asynq) ----
REDIS_URL=redis://:redis_dev_password@localhost:6379/0

# ---- Auth ----
# WAJIB minimal 32 byte acak. Generate: openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_RAHASIA_ACAK_MINIMAL_32_BYTE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h             # 30 hari
COOKIE_DOMAIN=
COOKIE_SECURE=false                # true di staging/production (HTTPS wajib)
ACCESS_COOKIE_NAME=kalengo_at
REFRESH_COOKIE_NAME=kalengo_rt
# CSRF: cookie berisi token yang harus dicerminkan klien di header (double-submit).
CSRF_COOKIE_NAME=kalengo_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# ---- Argon2id (parameter dicatat, jangan diubah tanpa migrasi hash) ----
ARGON2_MEMORY_KIB=65536            # 64 MiB
ARGON2_TIME=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# ---- Anti-abuse ----
TURNSTILE_SECRET_KEY=
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_VOUCHER_PER_MIN=20
RATE_LIMIT_ORDER_PER_MIN=10

# ---- Penyedia eksternal (pilihan PRD §20 no. 3 & 4) ----
PAYMENT_PROVIDER=midtrans          # midtrans
SHIPPING_PROVIDER=biteship         # biteship

# ---- Midtrans Snap (§6.5, terpilih) ----
MIDTRANS_ENV=sandbox               # sandbox | production
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_WEBHOOK_SIGNATURE_REQUIRED=true

# ---- Biteship (§6.4, terpilih) ----
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_RATES_CACHE_TTL=5m

# ---- Email / SMTP (dev pakai MailHog) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KALENGO <no-reply@kalengo.test>
SMTP_TLS=false

# ---- Object Storage (S3/MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kalengo-media
S3_ACCESS_KEY=kalengo
S3_SECRET_KEY=minio_dev_password
S3_USE_PATH_STYLE=true

# ---- Web Push (VAPID) ----
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kalengo.test

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# ---- Order lifecycle (§6.4) ----
ORDER_RESERVATION_MINUTES=15
