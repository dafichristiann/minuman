# ============================================================
# KALENGO Web — variabel lingkungan Vite
#
# HANYA nilai yang memang publik. Vite menanamkan nilai ini ke bundel klien,
# jadi JANGAN pernah menaruh rahasia (kunci API, token) di sini (§13.1).
# ============================================================

# Basis URL API. Kosongkan untuk memakai proxy dev Vite (/api → localhost:8080).
VITE_API_BASE_URL=

# development | staging | production — mengendalikan overlay diagnostik.
VITE_APP_ENV=development

# Overlay diagnostik M0 (panel status API). Wajib "false" di produksi.
VITE_ENABLE_DEV_OVERLAY=true
